# Copy this file to `.env` and fill in your own values.
# These are loaded at build time by Vite. After editing, restart `npm run dev`.

# --- Firebase (Project settings > General > Your apps > Web app config) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Google Maps (used for automatic travel-distance calculation) ---
# Enable "Maps JavaScript API" + "Distance Matrix API" + "Places API" and
# create an API key restricted to your domain.
VITE_GOOGLE_MAPS_API_KEY=
